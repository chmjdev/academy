{
  "name": "academy",
  "version": "1.0.0",
  "suite": "binteca",
  "title": "ANC CC Ops Academy",
  "type": "fullstack",
  "runtime": "node",
  "driver": "docker",
  "dev_driver": "native",
  "note": "ANC CC Ops Academy — Official Digital Governance Learning & Command Platform by CEDEC Africa on academy.cedec.io. Port 3155. Deployed on ancopsprod only.",
  "repo": "https://github.com/chmjdev/academy",
  "supported_stages": [
    "dev",
    "prod"
  ],
  "released": true,
  "ports": {
    "dev": 3155,
    "uat": 3155,
    "prod": 3155
  },
  "domains": {
    "uat": "",
    "prod": "academy.cedec.io"
  },
  "datastore": {
    "engine": "none",
    "stages": {
      "dev": {
        "provider": "none"
      },
      "prod": {
        "provider": "none"
      }
    }
  },
  "lifecycle": {
    "run": {
      "dev": "./start.sh dev",
      "prod": "./start.sh prod"
    },
    "restart": {
      "dev": "./start.sh restart"
    },
    "startup_checks": {
      "command": "./scripts/startup-checks.sh",
      "timeout_seconds": 30
    },
    "shutdown": {
      "command": "./start.sh stop",
      "grace_period_sec": 30
    }
  },
  "health_check": {
    "path": "/healthz",
    "interval_seconds": 10,
    "timeout_seconds": 5,
    "healthy_threshold": 2,
    "unhealthy_threshold": 3
  }
}
