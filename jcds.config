{
  "name": "academy",
  "version": "1.0.0",
  "suite": "binteca",
  "type": "fullstack",
  "runtime": "node",
  "driver": "docker",
  "dev_driver": "native",
  "repo": "https://github.com/chmjdev/academy",
  "note": "Govtech Academy — courses and how-to guides for every Govtech system, by CEDEC Africa on academy.cedec.io. Port 3155. Deployed on ancopsprod only.",
  "supported_stages": [
    "dev",
    "prod"
  ],
  "datastore": {
    "engine": "none",
    "stages": {
      "dev": {
        "provider": "none"
      },
      "prod": {
        "provider": "none"
      }
    }
  },
  "released": true,
  "ports": {
    "dev": 3155,
    "uat": 3155,
    "prod": 3155
  },
  "domains": {
    "uat": "",
    "prod": "academy.cedec.io"
  },
  "lifecycle": {
    "run": {
      "dev": "./start.sh dev",
      "uat": "./start.sh uat",
      "prod": "./start.sh prod"
    },
    "restart": {
      "dev": "./start.sh restart",
      "uat": "./start.sh restart",
      "prod": "./start.sh restart"
    },
    "update": {
      "command": "git pull origin main",
      "auto_stash": true
    },
    "startup_checks": {
      "command": "./scripts/startup-checks.sh",
      "timeout_seconds": 30
    },
    "shutdown": {
      "command": "./start.sh stop",
      "grace_period_sec": 30
    }
  },
  "health_check": {
    "path": "/healthz",
    "interval_seconds": 10,
    "timeout_seconds": 5,
    "max_retries": 5
  },
  "env_vars": {
    "required": [
      "PORT"
    ],
    "defaults": {
      "PORT": "3155"
    }
  }
}
